# Settings for n8n (queue mode).
# Do not edit this file. Run ./generate-env.sh (Windows: .\generate-env.ps1)
# to create your own ".env" from it with random secrets filled in.

# n8n version. The n8n and task runner images always use the same version.
# Releases: https://github.com/n8n-io/n8n/releases
N8N_VERSION=2.48.7

# Address you open in the browser. Must match server_name in nginx/conf.d/n8n-queue.conf
N8N_HOST=n8n-queue.apps.mylocalhost

# Your timezone, used by schedule triggers. List: https://momentjs.com/timezone/
GENERIC_TIMEZONE=UTC

# How many executions each worker runs at the same time (n8n recommends 5 or higher).
N8N_WORKER_CONCURRENCY=10

# Database
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=__GENERATED__

# Secrets
REDIS_PASSWORD=__GENERATED__
N8N_ENCRYPTION_KEY=__GENERATED__
N8N_RUNNERS_AUTH_TOKEN=__GENERATED__
